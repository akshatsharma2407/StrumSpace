# Copy this file to .env for local development.
# Values in .env are loaded by the application and must not be committed.

STRUMSPACE_APP_NAME=StrumSpace API
STRUMSPACE_APP_VERSION=0.1.0
STRUMSPACE_ENVIRONMENT=development
STRUMSPACE_DEBUG=false
STRUMSPACE_LOG_LEVEL=INFO
STRUMSPACE_API_V1_PREFIX=/api/v1
STRUMSPACE_TIMEZONE=Asia/Kolkata
