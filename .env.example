# Copy this file to .env for local development.
# Values in .env are loaded by the application and must not be committed.

STRUMSPACE_APP_NAME=StrumSpace API
STRUMSPACE_APP_VERSION=0.1.0
STRUMSPACE_ENVIRONMENT=development
STRUMSPACE_DEBUG=false
STRUMSPACE_LOG_LEVEL=INFO
STRUMSPACE_API_V1_PREFIX=/api/v1
STRUMSPACE_TIMEZONE=Asia/Kolkata

# Local MySQL development configuration.
STRUMSPACE_DATABASE_HOST=localhost
STRUMSPACE_DATABASE_PORT=3307
STRUMSPACE_DATABASE_NAME=strumspace
STRUMSPACE_DATABASE_USER=strumspace_user
STRUMSPACE_DATABASE_PASSWORD=YOUR_STRONG_PASSWORD
STRUMSPACE_DATABASE_POOL_SIZE=5
STRUMSPACE_DATABASE_MAX_OVERFLOW=10
STRUMSPACE_DATABASE_POOL_TIMEOUT=30
STRUMSPACE_DATABASE_POOL_RECYCLE=1800
STRUMSPACE_DATABASE_ECHO=false
